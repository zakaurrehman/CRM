# Normalise line endings in the repository; check out native on Windows.
* text=auto eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated — keep out of diffs and language stats.
data/alloys.ts      linguist-generated=true
data/alloy-index.ts linguist-generated=true
package-lock.json   linguist-generated=true
