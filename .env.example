# Copy to .env.local. Nothing here is required for local development.

# Public site URL used for canonical URLs, sitemap and Open Graph.
# Only set this if deploying somewhere other than the production domain.
NEXT_PUBLIC_SITE_URL=https://ims-metals.com

# --- Inquiry form delivery (server-side only, never exposed to the browser) ---
# Configure ONE of the two transports below before launch. With neither set, the
# API returns a clear error and the form tells the visitor to email directly, so
# an enquiry is never silently lost. In development, submissions are logged to
# the server console instead.

# Option A - POST each inquiry as JSON to a CRM, Zapier or Make endpoint.
INQUIRY_WEBHOOK_URL=

# Option B - send the inquiry by email through the Resend HTTP API.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=info@ims-metals.com
INQUIRY_FROM_EMAIL=website@ims-metals.com
