# Copy to .env.local for local development, or set these in the Vercel project
# settings for production. Nothing here is required to run the site locally.

# Public site URL used for canonical URLs, sitemap and Open Graph.
# Only set this if deploying somewhere other than the production domain.
NEXT_PUBLIC_SITE_URL=https://ims-metals.com


# ---------------------------------------------------------------------------
# INQUIRY FORM DELIVERY  (server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------
# Configure ONE of the three options below. Until one is set, the form tells
# the visitor the address to email and hands them a pre-filled message, so an
# enquiry is never silently lost. In development, submissions are logged to the
# server console instead.
#
# Where the enquiry lands. Defaults to info@ims-metals.com.
INQUIRY_TO_EMAIL=info@ims-metals.com


# --- Option A: your existing mailbox (usually the quickest) -----------------
# Uses the SMTP details for info@ims-metals.com from your email host. No new
# account, no new service, and mail leaves from an address recipients already
# trust. Ask your host for "SMTP settings" if you do not have them to hand.
#
#   Microsoft 365   smtp.office365.com   port 587
#   Google Workspace smtp.gmail.com      port 587  (needs an App Password)
#   cPanel / shared  mail.your-domain.com port 465 or 587
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
INQUIRY_FROM_EMAIL=


# --- Option B: send to a CRM, Zapier or Make ------------------------------
# The full enquiry is POSTed as JSON. Useful if enquiries should create a
# record rather than an email.
INQUIRY_WEBHOOK_URL=


# --- Option C: Resend -----------------------------------------------------
# Transactional email API. Needs an account and domain verification, but gives
# the best deliverability and a log of every message.
RESEND_API_KEY=


# ---------------------------------------------------------------------------
# LIVE MARKET DATA  (server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------
# Both feeds are read only inside lib/market/, which is marked `server-only`:
# importing it from a client component is a build error rather than a leaked
# key. The browser talks to /api/market, which returns numbers and no
# credentials.

# --- Metals prices ---------------------------------------------------------
# Without this the Live Metals Prices widget renders nothing at all. It is
# never filled with placeholder or example figures.
#
# The key was supplied without naming its service, so the provider is selected
# here. Both share a response shape; they differ in the query parameter names.
#   metals-api      https://metals-api.com        (LME industrial + precious)
#   metalpriceapi   https://metalpriceapi.com     (mostly precious + Cu, Al)
METALS_API_PROVIDER=metals-api
METALS_API_KEY=

# --- Currency conversion ---------------------------------------------------
# Optional. Left unset, rates come from exchangerate-api.com, which needs no
# key and is the same source the existing IMS webapp uses — so the currency
# selector works out of the box. Set this only to switch to Open Exchange
# Rates, which then takes precedence.
OPENEXCHANGERATES_APP_ID=
